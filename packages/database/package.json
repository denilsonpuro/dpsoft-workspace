{
  "name": "@dpsoft/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed-demo": "dotenv -e ../../.env -- tsx src/seed-demo.ts",
    "build": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.build.json"
  },
  "dependencies": { "@prisma/client": "6.12.0" },
  "devDependencies": { "@types/node": "^24.3.0", "dotenv-cli": "^10.0.0", "prisma": "6.12.0", "tsx": "^4.23.13", "typescript": "^5.9.2" }
}
